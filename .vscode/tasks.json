{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure macOS Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Clang-mac-os-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Triangle (macOS Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/Clang-mac-os-debug",
                "--target",
                "Triangle"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure macOS Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
